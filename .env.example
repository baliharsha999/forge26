# Server & Render Deployment Configuration
HOST=0.0.0.0
PORT=8000
LOW_MEMORY_MODE=true
VECTOR_DB_TYPE=faiss
CHROMA_PERSIST_DIR=data/chroma_db

# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & Reranking Models (Sentence Transformers & Cross-Encoder)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKING_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Configuration
DB_PATH=schemes.db
FAISS_INDEX_DIR=data/faiss_index

# LangSmith Tracing & Telemetry (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=government-scheme-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Document Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# FAISS HNSW Configuration
HNSW_M=32
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=32

# Retrieval Configuration
VECTOR_TOP_K=10
BM25_TOP_K=10
RRF_K=60
RERANK_INPUT_TOP_K=20
FINAL_TOP_K=5

# Evaluation Threshold
EVALUATION_THRESHOLD=0.75
