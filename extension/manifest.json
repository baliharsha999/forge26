{
  "manifest_version": 3,
  "name": "Nagarik AI - Civic Copilot",
  "version": "1.0.0",
  "description": "Empowering Every Citizen - Voice-guided automated civic complaint copilot for municipal and public portals.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.gov.in/*",
    "http://*.gov.in/*",
    "https://*.nic.in/*",
    "http://*.nic.in/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Nagarik AI Civic Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*.gov.in/*",
        "http://*.gov.in/*",
        "https://*.nic.in/*",
        "http://*.nic.in/*"
      ],
      "js": [
        "content/adapters/base_adapter.js",
        "content/adapters/mock_portal_adapter.js",
        "content/adapters/cpgrams_adapter.js",
        "content/adapters/generic_portal_adapter.js",
        "content/adapters/index.js",
        "content/content_script.js"
      ],
      "css": ["content/banner.css"]
    }
  ]
}
