{
  "manifest_version": 3,
  "name": "JanSetu Lite - Civic Complaint Copilot",
  "version": "1.0.0",
  "description": "Multimodal voice & photo civic assistant that fills municipal complaint portals in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://pgportal.gov.in/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open JanSetu Lite Civic Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/portal*",
        "http://127.0.0.1:8000/portal*",
        "https://pgportal.gov.in/*"
      ],
      "js": [
        "content/adapters/base_adapter.js",
        "content/adapters/mock_portal_adapter.js",
        "content/adapters/cpgrams_adapter.js",
        "content/adapters/index.js",
        "content/content_script.js"
      ],
      "css": ["content/banner.css"]
    }
  ]
}
