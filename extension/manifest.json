{
  "manifest_version": 3,
  "name": "Nagarik AI - Civic Copilot",
  "version": "1.2.3",
  "description": "Empowering Every Citizen - Dynamic AI Civic Copilot for detecting any public, municipal, or welfare portal on desktop and automating citizen tasks with zero-knowledge privacy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.gov.in/*",
    "*://*.nic.in/*",
    "*://*.mygov.in/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Nagarik AI Civic Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gov.in/*",
        "*://*.nic.in/*",
        "*://*.mygov.in/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "content/adapters/base_adapter.js",
        "content/adapters/mock_portal_adapter.js",
        "content/adapters/cpgrams_adapter.js",
        "content/adapters/generic_portal_adapter.js",
        "content/adapters/index.js",
        "content/content_script.js"
      ],
      "css": [
        "content/banner.css"
      ],
      "run_at": "document_idle"
    }
  ]
}