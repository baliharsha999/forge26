# ==============================================================================
# NAGARIK AI - WHATSAPP BOT SERVICE CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
WHATSAPP_PORT=8001
WHATSAPP_PHONE_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Cloud API (Production & Meta Business Suite)
# ------------------------------------------------------------------------------
# Set this to a random secret string. Enter the exact same string in Meta App Dashboard:
# WhatsApp -> Configuration -> Webhook -> Verify Token
WHATSAPP_VERIFY_TOKEN=nagarik_ai_secure_token_change_me_in_prod

# Meta Permanent or System User Access Token (whatsapp_business_messaging permission)
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_system_user_access_token_here

# Meta WhatsApp Phone Number ID (Found in WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=109876543210987

# Meta Graph API Version
META_GRAPH_VERSION=v21.0

# ------------------------------------------------------------------------------
# 3. Twilio WhatsApp Sandbox / Production
# ------------------------------------------------------------------------------
# Find in Twilio Console (twilio.com/console)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 4. Multilingual Speech Intelligence & LLM Inference
# ------------------------------------------------------------------------------
# Groq API for Whisper speech-to-text (Telugu, Hindi, English) & fast reasoning
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Key (Fallback multimodal audio & reasoning)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Supabase PostgreSQL & pgvector Schemes Database
# ------------------------------------------------------------------------------
# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 6. Zero-Knowledge Citizen Privacy Safeguards
# ------------------------------------------------------------------------------
# Auto-mask Aadhaar, Phone, PAN, Voter ID, and Bank Account numbers before logging/LLM
MASK_AADHAAR=true
MASK_PHONE=true
MASK_PAN=true
MASK_BANK_ACCOUNT=true
